{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Website (Python)",
      "type": "shell",
      "command": "py",
      "args": [
        "scripts/run_server.py"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Auto Commit Changes",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/auto_commit.ps1"
      ],
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
